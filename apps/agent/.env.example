MINECRAFT_SERVER_DIR=/path/to/server
MINECRAFT_SERVER_JAR=server.jar
MINECRAFT_MAX_MEMORY=2G
JAVA_PATH=java
GEMINI_API_KEY=your_gemini_key
GEMINI_MODEL=gemini-3.5-flash-lite
CONTROL_PLANE_URL=http://localhost:8787
SERVER_ID=my-server
PAIRING_CODE=change-me
AGENT_POLL_MS=1000
# EternalZero mode: set ETERNALZERO_SFTP_HOST to use SFTP instead of a local Minecraft process.
# Get these values from your EternalZero server's SFTP/File Manager connection details.
ETERNALZERO_SFTP_HOST=
ETERNALZERO_SFTP_PORT=22
ETERNALZERO_SFTP_USERNAME=
ETERNALZERO_SFTP_PASSWORD=
# Optional instead of password:
ETERNALZERO_SFTP_PRIVATE_KEY=
ETERNALZERO_SFTP_ROOT=.
ETERNALZERO_CACHE_ROOT=./.yazoni-eternalzero-cache
